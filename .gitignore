# TouchDesigner
# Backup files written next to .toe/.tox projects
Backup/
*.toe.*.toe
*.tox.*.tox
*.toeBackup
*.toxBackup
# Incremental saves (project.1.toe, project.2.toe, ...)
*.[0-9]*.toe
*.[0-9]*.tox

# Rendered exports (ProRes masters, transcodes)
render/

# TouchDesigner local/runtime artifacts
*.dmp
*.log
local/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
